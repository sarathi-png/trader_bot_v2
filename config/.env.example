# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Runtime storage (Hugging Face persistent storage is mounted at /data)
# DATA_DIR=/data
# DB_PATH=/data/trading_bot_v3.db
# CHART_DIR=/data/charts

# Exchange Configuration
EXCHANGE_NAME=binance

# Risk Management
ACCOUNT_RISK_PCT=1.0
ACCOUNT_BALANCE=10000.0

# v3 operations
SCAN_INTERVAL_MINUTES=15
SCHEDULE_OFFSET_SECONDS=5
DEDUPE_ENABLED=true
KILL_SWITCH=false
EXECUTION_MODE=PAPER
MAX_DAILY_LOSS_PCT=3.0
MAX_OPEN_POSITIONS=5
MAX_POSITION_PCT=25.0

PAPER_FEE_PCT=0.1
PAPER_SLIPPAGE_PCT=0.02
OPENALGO_URL=
OPENALGO_API_KEY=
OPENALGO_ENABLED=false

# Stage 1: market data source + quality gates
# DELTA = crypto candles from Delta Exchange India public REST (yfinance fallback);
# YAHOO = previous behaviour (yfinance only).
DATA_SOURCE=DELTA
DELTA_BASE_URL=https://api.india.delta.exchange
DELTA_MAX_RPS=5
DATA_STALE_MAX_BARS=2
MAX_SPREAD_PCT=0.5
