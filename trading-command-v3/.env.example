# ---- Core -------------------------------------------------------------
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ---- API authentication (REQUIRED before any live credentials) ----------
# Every /api route is authenticated by middleware.ts. If API_PASSWORD is unset
# the API refuses to serve anything (HTTP 503) — it never falls open.
# Use a long random value, e.g. `openssl rand -hex 32`.
API_PASSWORD=
# Signs the session cookie. Set this separately from the password so a leaked
# cookie does not reveal the login secret. Falls back to API_PASSWORD if empty.
SESSION_SECRET=
# API_PASSWORD=
# SESSION_SECRET="

# ---- Delta Exchange India (optional; secrets stay server-side) --------
# Create keys at Delta India -> Profile -> API Management.
# Leave blank to run fully in demo mode.
DELTA_API_KEY=
DELTA_API_SECRET=

# Public market data via Delta REST (no credentials required)
DELTA_MARKET_ENABLED=true
# Optional overrides
# DELTA_REST_BASE=https://api.india.delta.exchange
# DELTA_WS_URL=wss://socket.india.delta.exchange

# ---- Feature flags (sensitive capabilities default OFF) ---------------
LIVE_EXECUTION_ENABLED=false
PAPER_TRADING_ENABLED=true
TRADINGVIEW_WEBHOOK_ENABLED=false
TRADINGVIEW_WEBHOOK_SECRET=
ORDERBOOK_ENABLED=true
STRATEGY_ENGINE_ENABLED=true
AUTO_S_R_ENABLED=true
JOURNAL_ENABLED=true
ANALYTICS_ENABLED=true
TELEGRAM_ENABLED=false

# ---- Optional infrastructure ------------------------------------------
# REDIS_URL=
# SESSION_SECRET=
